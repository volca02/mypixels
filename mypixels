    def key_pressed(self, wnd, event):
        if event.type == Gdk.EventType.KEY_PRESS:
            # If tab overview is active in standalone mode, handle navigation
            if self.tab_overview.active and self.tab_overview.mode == 'standalone':
                return self.tab_overview.handle_key(event)

            # skim through the bindings
            mods = event.state & Gtk.accelerator_get_default_mod_mask()
            keyval = Gdk.keyval_to_lower(event.keyval)

            # TODO: Could accelerate this by placing the key combination into a dict
            for bind in self.keybinds:
                if (bind[0] == keyval) and (bind[1] == mods):
                    bind[2](bind[3])
                    return True
            if (keyval == self.on_tabswitch_key):
                self.on_tabswitch = True
                self.update_tablist()
                # Show overview in switcher mode when Alt is pressed (if enabled)
                if self.config['tab_overview_on_alt'] and not self.tab_overview.active:
                    self.tab_overview.show(mode='switcher')

        # tangled terminals? if so, propagate
        tabn = self.notebook.get_current_page()
        tab = self.notebook.get_nth_page(tabn)

        if (tab in self.entangled):
            for term in self.entangled:
                term.emit("key-press-event", eventkey2gdkevent(event))
            return True

        return False

    def key_released(self, wnd, event):
        tabn = self.notebook.get_current_page()
        tab = self.notebook.get_nth_page(tabn)

        if (event.type == Gdk.EventType.KEY_RELEASE):
            mods = event.state & Gtk.accelerator_get_default_mod_mask()
            keyval = Gdk.keyval_to_lower(event.keyval)
            if (keyval == self.on_tabswitch_key):
                self.on_tabswitch = False
                self.update_tablist()
                # Hide overview when Alt is released (only if in switcher mode)
                if self.tab_overview.active and self.tab_overview.mode == 'switcher':
                    self.tab_overview.hide()

        if (tab in self.entangled):
            for term in self.entangled:
                term.emit("key-release-event", eventkey2gdkevent(event))
            return True
        return False

    def enlarge_font(self, param):
        self.zoom(True)

    def shrink_font(self, param):
        self.zoom(False)

    def on_scroll(self, widget, event):
        # Handles zoom in / zoom out on Ctrl+mouse wheel
        accel_mask = Gtk.accelerator_get_default_mod_mask()
        if event.state & accel_mask == Gdk.ModifierType.CONTROL_MASK:
            direction = event.get_scroll_deltas()[2]
        if direction > 0:  # scrolling down -> zoom out
            self.zoom(False)
        else:
            self.zoom(True)

    def zoom(self, zoom):
        for idx, tab in enumerate(self.notebook):
            pangodesc = tab.get_font()
            fontsize = pangodesc.get_size()

            if fontsize > Pango.SCALE and not zoom:
                fontsize -= Pango.SCALE
            elif zoom:
                fontsize += Pango.SCALE

            pangodesc.set_size(fontsize)
            self.fontsize=fontsize
            tab.set_font(pangodesc)


    def new_tab(self, command=None, tnext=False, title="", cmd=None):
        # new tab instance
        tab = Vte.Terminal()
        tab.connect("child-exited", self.child_exited)
        tab.connect("eof", self.child_eof)
        tab.connect("window-title-changed", self.window_title_changed)
        tab.connect("scroll-event", self.on_scroll)
#        tab.connect("key-press-event", self.key_pressed)
#        tab.connect("key-release-event", self.key_released)

        tab.set_font(Pango.FontDescription(self.config["term_font"]))
        tab.set_scrollback_lines(self.config['scrollback_lines'])
        tab.search_set_wrap_around(True)

        tab.set_word_char_exceptions("-A-Za-z0-9,./?%&#:_~")
        self.apply_tab_colors(tab)

        tid = self.counter.__next__()

        if self.fontsize:
            pangodesc = tab.get_font()
            pangodesc.set_size(self.fontsize)
            tab.set_font(pangodesc)

        # The empty argv list is a fix for zsh segv...
        command=[Vte.get_user_shell()]
        if (cmd):
            command = cmd
        elif (self.command):
            command=self.command

        tab.spawn_async(
            Vte.PtyFlags.DEFAULT,
            os.environ['HOME'],
            command,
            [],
            GLib.SpawnFlags.DEFAULT,
            None,   # child_setup
            None,   # child_setup_data
            -1,     # timeout (no timeout)
            None,   # cancellable
            None,   # callback (optional)
            None    # user_data (optional)
        )

        tab.show()

#        if (command):
#            tab.feed_child(command)

        self.notebook.insert_page(tab, None, tnext and self.notebook.get_current_page() + 1 or -1)
        self.notebook.set_tab_reorderable(tab, True)

        if not title:
            title = self.config["default_tab_title"]

        self.tabs[tab] = {"title": title, "id": tid}
        self.update_tablist()

        tab.grab_focus()

    def new_window(self, param=None):
        """Create a new window"""
        self.app.new_window()

    def update_tablist(self):
        """Update the tab list display"""
        self.tab_list.update(force_hide=self.forcedHideTabs)



    def next_tab(self, skip=1, move=False):
        """ Focuses next tab. If skip is negative, focuses last tab.
        If move is true, moves the tab to the place (otherwise it just focuses)
        """
        if not skip:
            skip = 1

        ntabs = self.notebook.get_n_pages()

        if (ntabs <= 0):
            return

        if skip < 0:
            tabn = ntabs - 1
        else:
            tabn = (self.notebook.get_current_page() + skip) % ntabs

        self.goto_tab(tabn, move)

    def prev_tab(self, skip=1, move=False):
        """ Focuses previous tab. If skip is negative, focuses first tab.
        If move is true, moves the tab to the place (otherwise it just focuses)
        """
        if not skip:
            skip = 1

        ntabs = self.notebook.get_n_pages()

        if (ntabs <= 0):
            return

        if skip < 0:
            tabn = 0
        else:
            tabn = (self.notebook.get_current_page() - skip) % ntabs

        while (tabn < 0):
            tabn += ntabs

        self.goto_tab(tabn, move)

    def move_next_tab(self, skip=1):
        """ Like next_tab, but moves the current tab to the place """
        self.next_tab(skip, move=True)

    def move_prev_tab(self, skip=1):
        """ Like next_tab, but moves the current tab to the place """
        self.prev_tab(skip, move=True)

    def move_first_tab(self, arg=None):
        self.prev_tab(-1, move=True)

    def move_last_tab(self, arg=None):
        self.next_tab(-1, move=True)

    def highlight_tabs(self, toggle):
        pass

    def goto_tab(self, tabn, move=False):
        if move:
            idx = self.notebook.get_current_page()
            tab = self.notebook.get_nth_page(idx)
            self.notebook.reorder_child(tab, tabn)

        self.notebook.set_current_page(tabn)
        self.update_tablist()

    def toggle_entangle(self, ignored):
        tab = self.get_current_tab()

        if tab in self.entangled:
            self.entangled = filter(lambda t: t != tab, self.entangled)
        else:
            self.entangled.append(tab)

        self.update_tablist()

    def toggle_hide_tabs(self, tabn=None):
        self.forcedHideTabs = not self.forcedHideTabs
        self.update_tablist()

    def close_tab(self, tabn=None):
        # TODO: What if this ended when not a current page?
        if not tabn:
            tabn = self.notebook.get_current_page()
        if (tabn >= 0):
            self.notebook.remove_page(tabn)

    def rename_tab(self, tabn=None):
        if not tabn:
            tabn = self.notebook.get_current_page()

        tab = self.notebook.get_nth_page(tabn)
        name = dialog_get_text(
            self.window, "Tab name", self.tabs[tab].get('name', ''))
        if name:
            self.tabs[tab]['name'] = name
            self.update_tablist()

    def tab_closed(self, notebook, tab, index):
        # Clean up tab data and cache
        if tab in self.tabs:
            del self.tabs[tab]
        self.tab_overview.invalidate_cache(tab)

        if (self.notebook.get_n_pages() == 0):
            self.quit_request()
        else:
            tabn = self.notebook.get_current_page()
            # refocus
            self.notebook.set_current_page(tabn)

        self.update_tablist()


    def child_exited(self, term, status):
        for idx, tab in enumerate(self.notebook):
            if tab == term:
                self.notebook.remove_page(idx)
        self.update_tablist()

    def child_eof(self, a=None, b=None):
        pass

    def window_title_changed(self, term):
        self.tabs[term]['title'] = term.get_property("window-title")
        self.update_tablist()

    def tab_opened(self, notebook, tab, index):
        if self.config["focus_new_tabs"]:
            self.notebook.set_focus_child(tab)
            self.notebook.set_current_page(index)
        else:
            oldindex = self.notebook.get_current_page()

            if oldindex < 0:
                oldindex = index

            oldtab = self.notebook.get_nth_page(oldindex)
            self.notebook.set_focus_child(oldtab)
            self.notebook.set_current_page(oldindex)

        # Refresh overview if active
        if self.tab_overview.active:
            mode = self.tab_overview.mode
            self.tab_overview.hide()
            self.tab_overview.show(mode=mode)

    def tab_changed(self, notebook, tab, index):
        self.update_tablist()

        # Update overview selection if in switcher mode
        if self.tab_overview.active and self.tab_overview.mode == 'switcher':
            # Update selection to highlight current tab immediately
            self.tab_overview.update_selection(index)

            # Capture snapshot with delay to allow terminal to render
            def capture_and_update():
                current_page = self.notebook.get_current_page()
                if current_page >= 0 and current_page == index:  # Still on the same tab
                    tab = self.notebook.get_nth_page(current_page)
                    pixbuf = self.tab_overview.capture_terminal_snapshot(tab)
                    if pixbuf:
                        self.tab_overview.snapshot_cache[tab] = pixbuf
                        # Update the tile image
                        self.tab_overview.update_tile_image(index)
                return False

            GLib.timeout_add(500, capture_and_update)  # 500ms delay for terminal rendering
        else:
            # Normal update with delay when not in switcher mode
            GLib.timeout_add(50, lambda: self.tab_overview.update_snapshot_cache(force=True))

    def tab_reordered(self, notebook, tab, index):
        self.update_tablist()
        # Refresh overview if active in switcher mode
        if self.tab_overview.active and self.tab_overview.mode == 'switcher':
            # Hide and re-show to refresh the grid layout
            self.tab_overview.hide()
            self.tab_overview.show(mode='switcher')

    def switch_group(self, skip):
        tabn = self.notebook.get_current_page()
        tab = self.notebook.get_nth_page(tabn)

        params = self.tabs.setdefault(tab, {})

        grp = params.setdefault("group", 0) + skip

        # if the group goes beyond 0 or max
        if grp < 0:
            grp = max_groups - 1

        if grp >= max_groups:
            grp = 0

        # if the group is zero, remove the def
        # otherwise replace
        if grp == 0:
            del params["group"]
        else:
            params["group"] = grp

        # update tab view
        self.update_tablist()

    def show_search(self, param=None):
        self.search_entry.show()
        self.search_entry.grab_focus()

    def hide_search(self, param=None):
        self.search_entry.hide()

    def search_advance(self, forward=True):
        tab = self.get_current_tab()
        if (forward):
            tab.search_find_next()
        else:
            tab.search_find_previous()

    def font_selector(self, param=None):
        font_chooser = Gtk.FontSelectionDialog("Terminal font", self.window)
        font_chooser.set_font_name(self.config["term_font"])
        res = font_chooser.run()

        if res == Gtk.ResponseType.OK:
            fname = font_chooser.get_font_name()
            font_desc = Pango.FontDescription(fname)
            if font_desc:
                self.config["term_font"] = fname
                for tab in self.tabs:
                    tab.set_font(font_desc)

        font_chooser.destroy()

    def get_current_tab(self):
        tabn = self.notebook.get_current_page()
        return self.notebook.get_nth_page(tabn)

    def search_lose_focus(self, wnd, event):
        self.hide_search()
        # re-focus current tab
        self.get_current_tab().grab_focus()

    def search_key_pressed(self, wnd, event):
        if event.type == Gdk.KEY_PRESS:
            if (event.keyval == Gdk.KEY_Escape):
                self.hide_search()
                return False
            if (event.keyval == Gdk.KEY_Return):
                self.update_search_term(self.search_entry.get_text())
                self.hide_search()
                self.search_advance(True)
                return False
        return False

    def update_search_term(self, text):
        tab = self.get_current_tab()
        regex = GLib.Regex(text, 0, 0)
        tab.search_set_gregex(regex, 0)

    def show_tab_overview(self, param=None):
        """Show tab overview - delegates to TabOverview class"""
        self.tab_overview.show(mode='standalone')

    def run(self):
        """Deprecated - kept for backward compatibility

        The main loop is now handled by MypixelsApplication.
        This method is only called from old code paths.
        """
        # Command args now handled by Application
        self.command = None
        self.new_tab()
        Gtk.main()

    def quit_request(self, *args):
        # if there is more than one tab, ask
        if (self.notebook.get_n_pages() > 1):
            # ask first
            dialog = Gtk.MessageDialog(transient_for=self.window,
                                       modal=True, destroy_with_parent=True,
                                       message_type=Gtk.MessageType.INFO,
                                       buttons=Gtk.ButtonsType.YES_NO,
                                       text="Do you really want to close?")

            rv = dialog.run()
            dialog.destroy()

            if rv != Gtk.ResponseType.YES:
                return True # cancel the quit

        # Cleanup and quit
        # Remove this window from the application
        self.app.remove_window(self)

        # If this was the last window, quit the application
        if len(self.app.windows) == 0:
            self.app.quit()
        else:
            # Just close this window
            self.window.destroy()

        return True  # Prevent default close handler

    def load_config(self):
        config_path = Path.home() / ".mypixels"

        try:
            if not config_path.exists():
                print(f"No config file found at {config_path}, using defaults")
                self.load_wal_palette()
                return

            with open(config_path) as f:
                myconfig = yaml.load(f, Loader=yaml.FullLoader)

            try:
                for k in self.config.keys():
                    # if this is a keymap, descend
                    if k == "bindings":
                        if "bindings" in myconfig:
                            for fn, b in myconfig['bindings'].items():
                                self.config[k][fn] = b
                    else:
                        if k in myconfig:
                            self.config[k] = myconfig[k]
            except Exception as e:
                print(f"Config parse error: {e}")

            # Validate configuration
            validation_warnings = validate_config(self.config)
            if validation_warnings:
                print("Configuration validation warnings:")
                for warning in validation_warnings:
                    print(f"  - {warning}")

        except Exception as e:
            print(f"Error loading config from {config_path}: {e}")
            traceback.print_exc()

        # try to override the colors from wal palette if that is set to be used
        self.load_wal_palette()

    def apply_tab_colors(self, tab):
        bg_color = Gdk.RGBA()
        bg_color.parse(self.config['bg_tint_color'])
        bg_color.alpha=1.0-self.config['term_opacity']

        if self.palette:
            # Apply the same alpha to the palette background color
            transparent_bg = self.bg_color.copy()
            transparent_bg.alpha = 1.0-self.config['term_opacity']
            tab.set_colors(self.fg_color, transparent_bg, self.palette)
        else:
            # No palette, just set foreground and background with transparency
            tab.set_colors(self.fg_color, bg_color, [])

    def apply_config(self):
        # higlights tab nums on press
        self.on_tabswitch_key = key_press_parse(self.config["tab_highlight_mod"])[1]

        # parse the config key bindings
        self.set_funcmap()
        self.keymap = self.config['bindings']
        self.transform_keybinds()

        # convert the call config vars to callables
        if 'palette' in self.config:
            colors = self.config['palette'].split(':')
            self.palette = []
            for color in colors:
                if color:
                    self.palette.append(parse_rgba(color))
        else:
            self.palette = None

        self.fg_color = parse_rgba(self.config['foreground_color'])
        self.bg_color = parse_rgba(self.config['background_color'])

        

        fontdesc = Pango.FontDescription(self.config["tablist_font"])
        font_size_in_pt = fontdesc.get_size() / Pango.SCALE

        bgcolor = self.config['tablist_background']
        # TODO: self.tab_list.get_widget().modify_bg(Gtk.STATE_NORMAL, bgcolor)

        css = f"""
        #tabbar {{
            background-color: {bgcolor};
        }}
        #tabbar GtkEventBox {{ /* Style for individual tab containers */
            padding: 2px 8px; /* Add some padding for visual separation */
            margin-right: 1px; /* Space between tabs */
        }}
        #tabbar .tab-label {{ /* Style for the text within tabs */
            font-family: "{fontdesc.get_family()}";
            font-size: {font_size_in_pt}pt;
        }}
        #tabbar #add-tab-button {{ /* Style for the add tab button */
            background-color: {brighten(bgcolor, 1.1)}; /* Slightly brighter background for the button */
            padding: 2px 8px;
            margin-right: 1px;
        }}
        #tabbar #add-tab-button .tab-label {{ /* Style for the text within the add tab button */
            color: {self.config['add_button_color']};
        }}
        """

        style_provider = Gtk.CssProvider()
        style_provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        if self.config["tablist_top"]:
            self.vbox.reorder_child(self.tab_list.get_widget(), 0)
            self.vbox.reorder_child(self.notebook, 1)
        else:
            self.vbox.reorder_child(self.notebook, 1)
            self.vbox.reorder_child(self.tab_list.get_widget(), 2)

        # window fixup before we create tab
        if self.config["default_maximize"]:
            self.window.maximize()
        else:
            self.window.resize(self.config["default_width"], self.config["default_height"])


        # iterate all tabs in our list and re-apply the background
        for idx, tab in enumerate(self.notebook):
            self.apply_tab_colors(tab)

        # repaint the tab bar
        self.update_tablist()

    def reload_config(self, arg=None):
        print("Reloading config...")
        # tries to reload config and re-apply what can be
        self.load_config()
        self.hook_wal_reloads()
        self.apply_config()

    def file_changed(monitor, file, other, unknown, event, self):
        if event == Gio.FileMonitorEvent.CHANGES_DONE_HINT:
           self.load_wal_palette()
           self.apply_config()

    def hook_wal_reloads(self):
        wal_path = Path(self.config['wal_palette']).expanduser()
        self.wal_file = Gio.File.new_for_path(str(wal_path))
        print(f"Will monitor {self.wal_file.get_uri()}")
        self.monitor = self.wal_file.monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", self.file_changed, self)

    def load_wal_palette(self):
        # if specified in config file, we try to load the yml version of wal palette
        if ('wal_palette' not in self.config) or self.config['wal_palette'] == '':
            print("No wal_palette specified in config. Skipping")
            return

        wal_path = Path(self.config['wal_palette']).expanduser()

        try:
            if not wal_path.exists():
                print(f"Wal palette file not found: {wal_path}")
                return

            with open(wal_path) as f:
                mypal = yaml.load(f, Loader=yaml.FullLoader)
                # special category contains foreground and background
                bgcol  = mypal['special']['background']
                fgcol  = mypal['special']['foreground']
                curcol = mypal['special']['cursor']

                src_cols = mypal['colors']
                colors = []
                for n in range(0, 16):
                      colors.append(src_cols['color' + str(n)])

                # that's all there's to it, really. Now we apply those
                tab_bg = brighten(bgcol, 1.5)

                self.config['background_color']   = bgcol
                self.config['bg_tint_color']      = bgcol
                self.config['foreground_color']   = fgcol

                self.config['tablist_background'] = tab_bg
                self.config['tab_color_bg'] = tab_bg
                self.config['tab_color_bg_selected'] = brighten(tab_bg, 1.5)
                self.config['tab_color_fg'] = fgcol
                self.config['tab_color_fg_selected'] = curcol

                self.config['tab_color_entangle'] = colors[1]
                self.config['tab_color_idx'] = colors[2]

                for n in range(0,8):
                      self.config['col_' + str(n)] = colors[n]

                # and at last, the palette
                self.config['palette'] = ':'.join(colors)

                print("Loaded wal colors")
        except Exception as e:
            exc_info = sys.exc_info()
            traceback.print_exception(*exc_info)
            print("Cannot load/apply wal colors: %s!" % repr(e))

class MypixelsApplication(Gtk.Application):
    """Application-level manager for mypixels

    Manages multiple windows, shared configuration, and D-Bus single-instance detection.
    """

    def __init__(self):
        super().__init__(
            application_id="com.github.volca.mypixels",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )
        self.windows = []  # List of MypixelsWindow instances
        self.command_args = None
        self.config = config  # Shared config across all windows
        self.tab_counter = counter()  # Global tab ID generator

    def do_activate(self):
        """Called when application is activated (first launch or by remote instance)"""
        # Always create a new window
        self.new_window(self.command_args)

    def new_window(self, command=None):
        """Create a new window

        Args:
            command: Optional command to run in new tabs
        """
        window = MypixelsWindow(self)
        self.windows.append(window)
        self.add_window(window.window)

        # Set command if provided
        if command:
            window.command = command

        # Create first tab
        window.new_tab()

        # Show window
        window.window.present()

    def remove_window(self, window):
        """Remove a window from the application

        Args:
            window: MypixelsWindow instance to remove
        """
        if window in self.windows:
            self.windows.remove(window)

    def do_command_line(self, command_line):
        """Called when mypixels is run again while already running"""
        # Get command line arguments
        argv = command_line.get_arguments()

        # Store args for new window (skip program name)
        if len(argv) > 1:
            self.command_args = argv[1:]
        else:
            self.command_args = None

        # Activate (will create window or bring to front)
        self.activate()

        return 0  # Return 0 for success

def main():
    """Main entry point for mypixels"""
    app = MypixelsApplication()
    exit_status = app.run(sys.argv)
    sys.exit(exit_status)

if __name__ == '__main__':
    main()
