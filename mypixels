            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1
        )

        self.overlay.add_overlay(bg_box)
        bg_box.show_all()
        self.overview_bg_box = bg_box

        self.update_selection()

        # Start periodic updates in switcher mode
        if mode == 'switcher':
            # Update every 1000ms (1 second)
            self.update_timer_id = GLib.timeout_add(1000, self.periodic_update_callback)

    def hide(self):
        """Hide the tab overview"""
        if not self.active:
            return

        self.active = False

        # Cancel periodic update timer if running
        if self.update_timer_id is not None:
            GLib.source_remove(self.update_timer_id)
            self.update_timer_id = None

        if self.overview_bg_box:
            self.overlay.remove(self.overview_bg_box)
            self.overview_bg_box = None
        self.overview_tiles = []

        # Refocus current tab in standalone mode
        if self.mode == 'standalone':
            current_page = self.notebook.get_current_page()
            if current_page >= 0:
                tab = self.notebook.get_nth_page(current_page)
                tab.grab_focus()

    def update_selection(self, new_index=None):
        """Update visual indication of selected tile"""
        if not self.active or not self.overview_tiles:
            return

        if new_index is not None:
            self.selected = new_index

        for idx, tile in enumerate(self.overview_tiles):
            if idx == self.selected:
                tile.set_name("overview-tile-selected")
            else:
                tile.set_name("overview-tile")

    def update_tile_image(self, tab_index):
        """Update the image of a specific tile

        Args:
            tab_index: Index of the tab to update
        """
        if not self.active or not self.overview_tiles:
            return

        if tab_index < 0 or tab_index >= len(self.overview_tiles):
            return

        # Get the terminal widget
        tab = self.notebook.get_nth_page(tab_index)
        if tab not in self.snapshot_cache:
            return

        # Find the image widget in the tile and update it
        tile_box = self.overview_tiles[tab_index]
        tile_vbox = tile_box.get_child()
        if not tile_vbox:
            return

        # Find the Gtk.Overlay that contains the image
        preview_overlay = None
        for child in tile_vbox.get_children():
            if isinstance(child, Gtk.Overlay):
                preview_overlay = child
                break

        if not preview_overlay:
            return

        # Get the first child of the overlay (the image or placeholder)
        image = preview_overlay.get_child()
        if not isinstance(image, Gtk.Image):
            return

        # Update the image
        pixbuf = self.snapshot_cache[tab]
        # Calculate thumbnail size
        n_pages = self.notebook.get_n_pages()
        import math
        cols = math.ceil(math.sqrt(n_pages * 1.5))
        rows = math.ceil(n_pages / cols)
        window_width = self.window.get_allocated_width()
        window_height = self.window.get_allocated_height()
        available_width = window_width - 100
        available_height = window_height - 100
        thumb_width = min(400, (available_width // cols) - 20)
        thumb_height = min(300, (available_height // rows) - 60)

        scaled_pixbuf = pixbuf.scale_simple(
            thumb_width, thumb_height,
            GdkPixbuf.InterpType.BILINEAR
        )
        image.set_from_pixbuf(scaled_pixbuf)

    def handle_key(self, event):
        """Handle keyboard navigation (standalone mode only)

        Returns True if handled, False otherwise
        """
        if not self.active or self.mode != 'standalone':
            return False

        keyval = event.keyval
        mods = event.state & Gtk.accelerator_get_default_mod_mask()
        n_pages = self.notebook.get_n_pages()

        import math
        cols = math.ceil(math.sqrt(n_pages * 1.5))

        # Check for close tab keybinds
        close_key, close_mods = self.keybinds['close_tab']
        close_key_alt, close_mods_alt = self.keybinds['close_tab_alt']

        if (keyval == close_key and mods == close_mods) or \
           (keyval == close_key_alt and mods == close_mods_alt):
            # Close the selected tab
            if self.selected >= 0 and self.selected < n_pages:
                self.notebook.remove_page(self.selected)
                # Refresh the overview
                new_n_pages = self.notebook.get_n_pages()
                if new_n_pages == 0:
                    self.hide()
                else:
                    # Adjust selection if needed
                    if self.selected >= new_n_pages:
                        self.selected = new_n_pages - 1
                    # Refresh overview
                    self.hide()
                    self.show(mode='standalone')
            return True

        # Check for new tab keybinds
        new_key, new_mods = self.keybinds['new_tab']
        new_key_alt, new_mods_alt = self.keybinds['new_tab_alt']

        if (keyval == new_key and mods == new_mods) or \
           (keyval == new_key_alt and mods == new_mods_alt):
            # Create new tab
            self.mypixels.new_tab()
            # Refresh overview to show new tab
            self.hide()
            self.show(mode='standalone')
            return True

        if keyval == Gdk.KEY_Escape:
            self.hide()
            return True
        elif keyval == Gdk.KEY_Return or keyval == Gdk.KEY_KP_Enter:
            self.notebook.set_current_page(self.selected)
            self.hide()
            return True
        elif keyval == Gdk.KEY_Left:
            if mods & Gdk.ModifierType.SHIFT_MASK:
                # Shift+Left: Move tab left
                if self.selected > 0:
                    tab = self.notebook.get_nth_page(self.selected)
                    self.notebook.reorder_child(tab, self.selected - 1)
                    self.selected -= 1
                    # Refresh overview
                    self.hide()
                    self.show(mode='standalone')
            else:
                # Left: Navigate left
                if self.selected > 0:
                    self.update_selection(self.selected - 1)
            return True
        elif keyval == Gdk.KEY_Right:
            if mods & Gdk.ModifierType.SHIFT_MASK:
                # Shift+Right: Move tab right
                if self.selected < n_pages - 1:
                    tab = self.notebook.get_nth_page(self.selected)
                    self.notebook.reorder_child(tab, self.selected + 1)
                    self.selected += 1
                    # Refresh overview
                    self.hide()
                    self.show(mode='standalone')
            else:
                # Right: Navigate right
                if self.selected < n_pages - 1:
                    self.update_selection(self.selected + 1)
            return True
        elif keyval == Gdk.KEY_Up:
            if mods & Gdk.ModifierType.SHIFT_MASK:
                # Shift+Up: Move tab up (towards beginning)
                if self.selected >= cols:
                    tab = self.notebook.get_nth_page(self.selected)
                    new_pos = self.selected - cols
                    self.notebook.reorder_child(tab, new_pos)
                    self.selected = new_pos
                    # Refresh overview
                    self.hide()
                    self.show(mode='standalone')
            else:
                # Up: Navigate up
                if self.selected >= cols:
                    self.update_selection(self.selected - cols)
            return True
        elif keyval == Gdk.KEY_Down:
            if mods & Gdk.ModifierType.SHIFT_MASK:
                # Shift+Down: Move tab down (towards end)
                if self.selected + cols < n_pages:
                    tab = self.notebook.get_nth_page(self.selected)
                    new_pos = self.selected + cols
                    self.notebook.reorder_child(tab, new_pos)
                    self.selected = new_pos
                    # Refresh overview
                    self.hide()
                    self.show(mode='standalone')
            else:
                # Down: Navigate down
                if self.selected + cols < n_pages:
                    self.update_selection(self.selected + cols)
            return True
        elif keyval == Gdk.KEY_Home:
            self.update_selection(0)
            return True
        elif keyval == Gdk.KEY_End:
            self.update_selection(n_pages - 1)
            return True
        elif keyval >= Gdk.KEY_1 and keyval <= Gdk.KEY_9:
            idx = keyval - Gdk.KEY_1
            if idx < n_pages:
                self.notebook.set_current_page(idx)
                self.hide()
            return True
        elif keyval == Gdk.KEY_0:
            if n_pages > 9:
                self.notebook.set_current_page(9)
                self.hide()
            return True

        return False

    def on_tile_clicked(self, widget, event, tab_index):
        """Handle mouse click on tile (standalone mode only)"""
        if event.button == 1 and self.mode == 'standalone':
            self.notebook.set_current_page(tab_index)
            self.hide()

    def on_close_button_clicked(self, button, tab_index):
        """Handle close button click in standalone mode"""
        n_pages = self.notebook.get_n_pages()
        if tab_index >= 0 and tab_index < n_pages:
            self.notebook.remove_page(tab_index)
            # Refresh the overview or hide if no tabs left
            new_n_pages = self.notebook.get_n_pages()
            if new_n_pages == 0:
                self.hide()
            else:
                # Adjust selection if needed
                if self.selected >= new_n_pages:
                    self.selected = new_n_pages - 1
                # Refresh overview
                self.hide()
                self.show(mode='standalone')

def dialog_get_text(parent, message, default=''):
    """
    Display a dialog with a text entry.
    Returns the text, or None if canceled.
    """
    d = Gtk.MessageDialog(transient_for=parent,
                          modal=True,
                          destroy_with_parent=True,
                          message_type=Gtk.MessageType.QUESTION,
                          buttons=Gtk.ButtonsType.OK_CANCEL,
                          text=message)
    entry = Gtk.Entry()
    entry.set_text(default)
    entry.show()
    d.vbox.pack_end(entry, False, False, 0)
    entry.connect('activate', lambda _: d.response(Gtk.ResponseType.OK))
    d.set_default_response(Gtk.ResponseType.OK)

    r = d.run()
    text = entry.get_text()
    d.destroy()
    if r == Gtk.ResponseType.OK:
        return text
    else:
        return None


class TabList:
    """Manages the tab list/bar display"""

    def __init__(self, notebook, tabs_dict, entangled_list, config_dict, on_tab_switch_state):
        """Initialize TabList

        Args:
            notebook: The Gtk.Notebook containing tabs
            tabs_dict: Dictionary mapping terminal widgets to tab metadata
            entangled_list: List of entangled terminals
            config_dict: Configuration dictionary
            on_tab_switch_state: Function returning current tab switch state
        """
        self.notebook = notebook
        self.tabs = tabs_dict
        self.entangled = entangled_list
        self.config = config_dict
        self.get_on_tabswitch = on_tab_switch_state

        # Create the container for tabs
        self.container = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.container.set_halign(Gtk.Align.START)
        self.container.set_valign(Gtk.Align.START)

        # Event box wrapper
        self.ebox = Gtk.EventBox()
        self.ebox.set_name("tabbar")
        self.ebox.add(self.container)
        self.ebox.show()  # Show the tab bar widget
        self.container.show()

        # Callbacks
        self.on_tab_clicked_cb = None
        self.on_add_tab_cb = None

    def get_widget(self):
        """Get the EventBox widget containing the tab list"""
        return self.ebox

    def set_callbacks(self, on_tab_clicked, on_add_tab):
        """Set callbacks for user interactions

        Args:
            on_tab_clicked: Callback(tab_index) when tab is clicked
            on_add_tab: Callback() when add button is clicked
        """
        self.on_tab_clicked_cb = on_tab_clicked
        self.on_add_tab_cb = on_add_tab

    def update(self, force_hide=False):
        """Update the tab list display

        Args:
            force_hide: If True, hide the tab list
        """
        # Clear existing tabs
        for child in self.container.get_children():
            self.container.remove(child)

        n_pages = self.notebook.get_n_pages()

        if (n_pages <= 1 and self.config["hide_single_tab"]) or force_hide:
            self.ebox.hide()
            return

        self.ebox.show()

        # Prepend callable if configured
        if self.config.get('tab_prepend'):
            prepend_label = Gtk.Label()
            prepend_label.set_use_markup(True)
            prepend_label.set_markup(callables[self.config['tab_prepend']]())
            self.container.pack_start(prepend_label, False, False, 0)
            prepend_label.show()

        # Add the [+] button
        add_tab_event_box = Gtk.EventBox()
        add_tab_event_box.set_name("add-tab-button")
        add_tab_event_box.set_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        add_tab_event_box.connect("button-press-event", self._on_add_tab_clicked)
        add_tab_event_box.set_tooltip_text("Create a new tab")

        add_tab_label = Gtk.Label()
        add_tab_label.set_markup("[+]")
        add_tab_label.set_margin_top(2)
        add_tab_label.set_margin_bottom(2)
        add_tab_label.get_style_context().add_class("tab-label")

        add_tab_event_box.add(add_tab_label)
        add_tab_event_box.show_all()
        self.container.pack_start(add_tab_event_box, False, False, 0)

        curidx = self.notebook.get_current_page()
        on_tabswitch = self.get_on_tabswitch()

        tab_format = self.config['tab_format']
        max_title_len = self.config['tab_title_max_length']
        tabl_short = self.config['tab_shorten_str']

        for idx, tab in enumerate(self.notebook):
            colfg = self.config["tab_color_fg"]
            colbg = self.config["tab_color_bg"]

            tid = idx + 1
            tidx = f"<span foreground=\"{self.config['tab_color_idx']}\">{tid}</span>"
            tname = ""

            tcorner = "["
