    def move_tab_to_window(self, tab_index, target_window):
        """Move a tab from this window to another window

        Args:
            tab_index: Index of tab to move
            target_window: MypixelsWindow instance to move tab to
        """
        # Get terminal and metadata
        terminal = self.notebook.get_nth_page(tab_index)
        if not terminal:
            return

        tab_data = self.tabs[terminal].copy()

        # Remove from entangled list if present (untangle on move)
        if terminal in self.entangled:
            self.entangled.remove(terminal)

        # Disconnect signal handlers from source window
        self._disconnect_tab_signals(terminal)

        # Remove from source tabs dict BEFORE removing from notebook
        # (widget identity may change after removal)
        del self.tabs[terminal]

        # Reparent the widget by removing from source and adding to target
        self.notebook.remove(terminal)

        # Add to target window
        page_num = target_window.notebook.append_page(terminal, None)
        target_window.notebook.set_tab_reorderable(terminal, True)
        target_window.tabs[terminal] = tab_data

        # Reconnect signal handlers to target window
        target_window._connect_tab_signals(terminal)

        # Check if source window will be empty
        source_window_empty = self.notebook.get_n_pages() == 0

        # Update target window tab list
        target_window.update_tablist()

        # Update source window tab list only if it still has tabs
        if not source_window_empty:
            self.update_tablist()

        # Focus target window and new tab
        target_window.window.present()
        target_window.notebook.set_current_page(page_num)

        # Close source window if no tabs left
        if source_window_empty:
            self.app.remove_window(self)
            self.window.destroy()

    def update_tablist(self):
