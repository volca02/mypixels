    def tab_opened(self, notebook, tab, index):
        if self.config["focus_new_tabs"]:
            self.notebook.set_focus_child(tab)
            self.notebook.set_current_page(index)
        else:
            oldindex = self.notebook.get_current_page()

            if oldindex < 0:
                oldindex = index

            oldtab = self.notebook.get_nth_page(oldindex)
            self.notebook.set_focus_child(oldtab)
            self.notebook.set_current_page(oldindex)

        # Refresh overview if active
        if self.tab_overview.active:
            mode = self.tab_overview.mode
            self.tab_overview.hide()
            self.tab_overview.show(mode=mode)

    def tab_changed(self, notebook, tab, index):
        self.update_tablist()

        # Update overview selection if in switcher mode
        if self.tab_overview.active and self.tab_overview.mode == 'switcher':
            # Update selection to highlight current tab immediately
            self.tab_overview.update_selection(index)

            # Capture snapshot with delay to allow terminal to render
            def capture_and_update():
                current_page = self.notebook.get_current_page()
                if current_page >= 0 and current_page == index:  # Still on the same tab
                    tab = self.notebook.get_nth_page(current_page)
                    pixbuf = self.tab_overview.capture_terminal_snapshot(tab)
                    if pixbuf:
                        self.tab_overview.snapshot_cache[tab] = pixbuf
                        # Update the tile image
                        self.tab_overview.update_tile_image(index)
                return False

            GLib.timeout_add(500, capture_and_update)  # 500ms delay for terminal rendering
        else:
            # Normal update with delay when not in switcher mode
            GLib.timeout_add(50, lambda: self.tab_overview.update_snapshot_cache(force=True))

    def tab_reordered(self, notebook, tab, index):
        self.update_tablist()
        # Refresh overview if active in switcher mode
        if self.tab_overview.active and self.tab_overview.mode == 'switcher':
            # Hide and re-show to refresh the grid layout
            self.tab_overview.hide()
            self.tab_overview.show(mode='switcher')

    def switch_group(self, skip):
        tabn = self.notebook.get_current_page()
        tab = self.notebook.get_nth_page(tabn)

        params = self.tabs.setdefault(tab, {})

        grp = params.setdefault("group", 0) + skip

        # if the group goes beyond 0 or max
        if grp < 0:
            grp = max_groups - 1

        if grp >= max_groups:
            grp = 0

        # if the group is zero, remove the def
        # otherwise replace
        if grp == 0:
            del params["group"]
        else:
            params["group"] = grp

        # update tab view
        self.update_tablist()

