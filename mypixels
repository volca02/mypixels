class TabOverview:
    """Standalone tab overview/switcher class"""

    def __init__(self, parent_window, overlay, notebook, tabs_dict, entangled_list, config, mypixels_instance):
        self.window = parent_window
        self.overlay = overlay
        self.notebook = notebook
        self.tabs = tabs_dict
        self.entangled = entangled_list
        self.config = config
        self.mypixels = mypixels_instance
        # Get application instance for multi-window support
        self.app = mypixels_instance.app

        self.active = False
        self.selected = 0
        self.mode = 'standalone'  # 'standalone' or 'switcher'

        self.overview_box = None
        self.overview_bg_box = None
        self.overview_tiles = []

        # Cache for terminal snapshots
        self.snapshot_cache = {}
        self.cache_timestamp = 0

        # Timer for periodic updates in switcher mode
        self.update_timer_id = None

        # Key bindings for standalone mode
        self.setup_keybinds()

    def setup_keybinds(self):
        """Setup key bindings for standalone mode - parse from config"""
        # Get the parent MypixelsWindow's parsed keybindings
        # We'll look them up by action name during key handling
        self.keybinds = {}

        # Parse overview-specific bindings from config
        bindings = self.config.get('bindings', {})
        for action, binding in bindings.items():
            if action.startswith('overview_') or action in ['close_tab', 'new_tab']:
                # Parse the binding string
                parsed = self._parse_keybind(binding)
                if parsed:
                    self.keybinds[action] = parsed

    def _parse_keybind(self, binding_str):
        """Parse a keybinding string like 'MOD1+Return' into (keyval, modmask)

        Args:
            binding_str: String or tuple of strings like 'MOD1+Return' or ('CONTROL+x', 'CONTROL+q')

        Returns:
            Tuple of (keyval, modmask) or list of tuples if multiple bindings
        """
        if isinstance(binding_str, (list, tuple)):
            # Multiple bindings - return list
            return [self._parse_single_keybind(b) for b in binding_str if self._parse_single_keybind(b)]
        else:
            return self._parse_single_keybind(binding_str)

    def _parse_single_keybind(self, binding_str):
        """Parse a single keybinding string

        Args:
            binding_str: String like 'MOD1+Return' or 'SHIFT+Left'

        Returns:
            Tuple of (keyval, modmask) or None if invalid
        """
        if not binding_str:
            return None

        parts = binding_str.split('+')
        if not parts:
            return None

        # Last part is the key
        key_name = parts[-1]

        # Build modifier mask
        modmask = 0
        for mod in parts[:-1]:
            mod_upper = mod.upper()
            if mod_upper == 'MOD1' or mod_upper == 'ALT':
                modmask |= Gdk.ModifierType.MOD1_MASK
            elif mod_upper == 'CONTROL' or mod_upper == 'CTRL':
                modmask |= Gdk.ModifierType.CONTROL_MASK
            elif mod_upper == 'SHIFT':
                modmask |= Gdk.ModifierType.SHIFT_MASK
            elif mod_upper == 'MOD4' or mod_upper == 'SUPER':
                modmask |= Gdk.ModifierType.MOD4_MASK

        # Get keyval from key name
        keyval = getattr(Gdk, f'KEY_{key_name}', None)
        if keyval is None:
            # Try lowercase
            keyval = getattr(Gdk, f'KEY_{key_name.lower()}', None)

        if keyval is None:
            return None

        return (keyval, modmask)

    def _check_keybind(self, keyval, mods, action_name):
        """Check if keyval+mods matches a configured keybinding

        Args:
            keyval: Gdk keyval from event
            mods: Modifier mask from event
            action_name: Action name to check (e.g. 'overview_exit')

        Returns:
            True if the key matches the action binding
        """
        if action_name not in self.keybinds:
            return False

        binding = self.keybinds[action_name]

        # Handle list of bindings
        if isinstance(binding, list):
            for b in binding:
                if b and len(b) == 2:
                    bind_key, bind_mods = b
                    if keyval == bind_key and mods == bind_mods:
                        return True
            return False
        # Handle single binding
        elif binding and len(binding) == 2:
            bind_key, bind_mods = binding
            return keyval == bind_key and mods == bind_mods

        return False

    def capture_terminal_snapshot(self, terminal):
        """Capture a snapshot of the terminal widget"""
        alloc = terminal.get_allocation()
        width = alloc.width
        height = alloc.height

        if width <= 0 or height <= 0:
            return None

        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, width, height)
        context = cairo.Context(surface)
        terminal.draw(context)
        pixbuf = Gdk.pixbuf_get_from_surface(surface, 0, 0, width, height)

        return pixbuf

    def update_snapshot_cache(self, force=False):
        """Update snapshot cache for all tabs

        Args:
            force: If True, bypass the time throttle
        """
        import time
        current_time = time.time()

        # Only update cache if more than 0.5 seconds have passed (unless forced)
        if not force and current_time - self.cache_timestamp < 0.5:
            return False

        self.cache_timestamp = current_time
        current_page = self.notebook.get_current_page()

        # Capture current tab (always visible) - key by terminal widget
        if current_page >= 0:
            tab = self.notebook.get_nth_page(current_page)
            pixbuf = self.capture_terminal_snapshot(tab)
            if pixbuf:
                self.snapshot_cache[tab] = pixbuf

        return False  # For GLib.timeout_add

    def get_cached_or_capture(self, terminal):
        """Get cached snapshot or capture new one

        Args:
            terminal: The VTE terminal widget to capture

        Returns:
            GdkPixbuf or None
        """
        # Try to get from cache first (keyed by terminal widget)
        if terminal in self.snapshot_cache:
            return self.snapshot_cache[terminal]

        # Try to capture (will only work if visible)
        pixbuf = self.capture_terminal_snapshot(terminal)
        if pixbuf:
            self.snapshot_cache[terminal] = pixbuf
        return pixbuf

    def invalidate_cache(self, terminal=None):
        """Invalidate snapshot cache

        Args:
            terminal: Specific terminal to invalidate, or None for all
        """
        if terminal is None:
            self.snapshot_cache.clear()
        elif terminal in self.snapshot_cache:
            del self.snapshot_cache[terminal]

    def periodic_update_callback(self):
        """Periodic callback to update active tab preview in switcher mode

        Returns:
            True to continue the timer, False to stop
        """
        if not self.active or self.mode != 'switcher':
            self.update_timer_id = None
            return False

        # Capture and update the current tab
        current_page = self.notebook.get_current_page()
        if current_page >= 0:
            tab = self.notebook.get_nth_page(current_page)
            pixbuf = self.capture_terminal_snapshot(tab)
            if pixbuf:
                self.snapshot_cache[tab] = pixbuf
                self.update_tile_image(current_page)

        return True  # Continue the timer

    def show(self, mode='standalone'):
        """Show tab overview

        Args:
            mode: 'standalone' for full control, 'switcher' for Alt-held mode
        """
        # If already active, check if we're switching modes
        if self.active:
            if self.mode == mode:
                # Same mode, toggle off
                self.hide()
                return
            else:
                # Different mode, switch to new mode
                self.hide()

        # Tab switcher only shows current window
        n_pages = self.notebook.get_n_pages()
        if n_pages == 0:
            return

        # Capture fresh snapshot of active tab in current window before showing
        current_page = self.notebook.get_current_page()
        if current_page >= 0:
            tab = self.notebook.get_nth_page(current_page)
            pixbuf = self.capture_terminal_snapshot(tab)
            if pixbuf:
                self.snapshot_cache[tab] = pixbuf

        self.active = True
        self.mode = mode
        self.selected = current_page

        # Create main container
        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        # Add mode indicator at the top
        mode_label = Gtk.Label()
        mode_label.set_use_markup(True)

        # Get font from config
        fontdesc = Pango.FontDescription(self.config["tablist_font"])
        font_size_in_pt = fontdesc.get_size() / Pango.SCALE
        font_family = fontdesc.get_family()

        if mode == 'standalone':
            mode_text = f'<span font_family="{font_family}" size="{int(font_size_in_pt * 2)}pt" foreground="#4a9a9a"><b>TAB OVERVIEW MODE</b></span>\n<span font_family="{font_family}" size="{int(font_size_in_pt * 1.2)}pt" foreground="#888">ESC: exit | Enter: select | Alt+Return: new tab | Arrows: navigate | Shift+Arrows: move tab | Ctrl+Alt+X: close</span>'
        else:
            mode_text = f'<span font_family="{font_family}" size="{int(font_size_in_pt * 1.5)}pt" foreground="#888"><b>Tab Switcher</b></span>'
        mode_label.set_markup(mode_text)
        mode_label.set_margin_bottom(10)
        main_vbox.pack_start(mode_label, False, False, 0)

        # Create overview container
        self.overview_box = Gtk.Grid()
        self.overview_box.set_row_spacing(10)
        self.overview_box.set_column_spacing(10)
        self.overview_box.set_margin_start(20)
        self.overview_box.set_margin_end(20)
        self.overview_box.set_margin_top(0)
        self.overview_box.set_margin_bottom(20)
        self.overview_box.set_halign(Gtk.Align.CENTER)
        self.overview_box.set_valign(Gtk.Align.CENTER)

        main_vbox.pack_start(self.overview_box, True, True, 0)

        # Create event box for background
        bg_box = Gtk.EventBox()
        bg_box.set_name("overview-background")
        bg_box.add(main_vbox)

        # Make it focusable and capture all key events
        bg_box.set_can_focus(True)
        bg_box.set_events(Gdk.EventMask.KEY_PRESS_MASK | Gdk.EventMask.KEY_RELEASE_MASK)
        bg_box.connect("key-press-event", self.on_key_press)
        bg_box.connect("key-release-event", self.on_key_release)

        # Calculate thumbnail size
        window_width = self.window.get_allocated_width()
        window_height = self.window.get_allocated_height()
        available_width = window_width - 100

        # Use config values or defaults
        max_thumb_width = self.config.get('tab_overview_thumb_width', 300)
        max_thumb_height = self.config.get('tab_overview_thumb_height', 225)

        thumb_width = min(max_thumb_width, available_width // 4 - 20)
        thumb_height = min(max_thumb_height, int(thumb_width * 0.75))

        # Store thumbnail dimensions for consistent sizing during updates
        self.thumb_width = thumb_width
        self.thumb_height = thumb_height

        self.overview_tiles = []

        # Calculate grid dimensions
        import math
        cols = math.ceil(math.sqrt(n_pages * 1.5))
        rows = math.ceil(n_pages / cols)

        # Create tiles for each tab
        for idx in range(n_pages):
            tab = self.notebook.get_nth_page(idx)
            row = idx // cols
            col = idx % cols

            tile_box = Gtk.EventBox()
            tile_box.set_name("overview-tile")
            tile_box.set_events(Gdk.EventMask.BUTTON_PRESS_MASK)

            # Only connect click handler in standalone mode
            if mode == 'standalone':
                tile_box.connect("button-press-event", self.on_tile_clicked, idx)

            tile_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            tile_vbox.set_margin_start(10)
            tile_vbox.set_margin_end(10)
            tile_vbox.set_margin_top(10)
            tile_vbox.set_margin_bottom(10)

            # Get tab title
            if tab in self.tabs:
                params = self.tabs[tab]
                title = params.get("name", params.get("title", ""))
            else:
                title = ""

            if not title:
                title = f"Tab {idx + 1}"

            if len(title) > 30:
                title = title[:27] + "..."

            # Create header with label
            header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
            header_box.set_halign(Gtk.Align.CENTER)

            # Color indicator
            if tab in self.tabs and "group" in self.tabs[tab]:
