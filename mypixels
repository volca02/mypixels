def validate_color(color_str: str) -> bool:
    """Validate that a string is a valid color format"""
    try:
        col = Gdk.RGBA()
        return col.parse(color_str)
    except:
        return False

def validate_config(cfg: Dict[str, Any]) -> List[str]:
    """Validate configuration and return list of warnings/errors

    Returns:
        List of warning/error messages (empty if all valid)
    """
    warnings = []

    # Validate colors
    color_keys = [
        'tablist_background', 'tab_color_bg', 'tab_color_bg_selected',
        'tab_color_fg', 'tab_color_fg_selected', 'tab_color_entangle',
        'tab_color_idx', 'bg_tint_color', 'foreground_color', 'background_color',
        'add_button_color'
    ]
    for i in range(max_groups):
        color_keys.append(f'col_{i}')

    for key in color_keys:
        if key in cfg and not validate_color(cfg[key]):
            warnings.append(f"Invalid color value for '{key}': {cfg[key]}")

    # Validate numeric ranges
    numeric_validations = {
        'scrollback_lines': (0, 100000, "must be between 0 and 100000"),
        'term_opacity': (0.0, 1.0, "must be between 0.0 and 1.0"),
        'tab_overview_opacity': (0.0, 1.0, "must be between 0.0 and 1.0"),
        'default_width': (100, 10000, "must be between 100 and 10000"),
        'default_height': (100, 10000, "must be between 100 and 10000"),
        'tab_title_max_length': (-1, 1000, "must be between -1 (unlimited) and 1000"),
    }

    for key, (min_val, max_val, msg) in numeric_validations.items():
        if key in cfg:
            val = cfg[key]
            if not isinstance(val, (int, float)) or val < min_val or val > max_val:
                warnings.append(f"Config '{key}' {msg}, got: {val}")

    # Validate boolean values
    bool_keys = [
        'focus_new_tabs', 'hide_single_tab', 'tablist_top', 'tab_title_shorten_start',
        'tablist_hide', 'default_maximize', 'tab_overview_on_alt'
    ]
    for key in bool_keys:
        if key in cfg and not isinstance(cfg[key], bool):
            warnings.append(f"Config '{key}' must be boolean (true/false), got: {cfg[key]}")

    # Validate font descriptions
    for font_key in ['tablist_font', 'term_font']:
        if font_key in cfg:
            try:
                desc = Pango.FontDescription(cfg[font_key])
                if not desc.get_family():
                    warnings.append(f"Invalid font description for '{font_key}': {cfg[font_key]}")
            except:
                warnings.append(f"Cannot parse font description for '{font_key}': {cfg[font_key]}")

    # Validate file paths
    if 'wal_palette' in cfg and cfg['wal_palette']:
        path = Path(cfg['wal_palette']).expanduser()
        if not path.exists() and not path.parent.exists():
            warnings.append(f"Wal palette parent directory doesn't exist: {cfg['wal_palette']}")

    # Validate key bindings
    if 'bindings' in cfg:
        for action, binding in cfg['bindings'].items():
            bindings_list = binding if isinstance(binding, (list, tuple)) else [binding]
            for bind_str in bindings_list:
                try:
                    mods, key = key_press_parse(bind_str)
                    if key is None or key == 0:
                        warnings.append(f"Invalid key binding for '{action}': {bind_str}")
                except Exception as e:
                    warnings.append(f"Cannot parse key binding for '{action}': {bind_str} - {e}")

    return warnings

# stolen from Terminator https://github.com/m45t3r/t3rminator/blob/master/terminatorlib/terminator.py
def eventkey2gdkevent(eventkey):  # FIXME FOR GTK3: is there a simpler way of casting from specific EventKey to generic (union) GdkEvent?
    gdkevent = Gdk.Event(eventkey.type)
    gdkevent.key.type = eventkey.type
    gdkevent.key.window = eventkey.window
    gdkevent.key.send_event = eventkey.send_event
    gdkevent.key.time = eventkey.time
    gdkevent.key.state = eventkey.state
    gdkevent.key.keyval = eventkey.keyval
    gdkevent.key.length = eventkey.length
    gdkevent.key.string = eventkey.string
    gdkevent.key.hardware_keycode = eventkey.hardware_keycode
    gdkevent.key.group = eventkey.group
    gdkevent.key.is_modifier = eventkey.is_modifier
    return gdkevent

def counter():
    """ Tab ID generator """
    i = 1
    while True:
        yield i
        i += 1

class TabOverview:
    """Standalone tab overview/switcher class"""

    def __init__(self, parent_window, overlay, notebook, tabs_dict, entangled_list, config, mypixels_instance):
        self.window = parent_window
        self.overlay = overlay
        self.notebook = notebook
        self.tabs = tabs_dict
        self.entangled = entangled_list
        self.config = config
        self.mypixels = mypixels_instance

        self.active = False
        self.selected = 0
        self.mode = 'standalone'  # 'standalone' or 'switcher'

        self.overview_box = None
        self.overview_bg_box = None
        self.overview_tiles = []

        # Cache for terminal snapshots
        self.snapshot_cache = {}
        self.cache_timestamp = 0

        # Timer for periodic updates in switcher mode
        self.update_timer_id = None

        # Key bindings for standalone mode
        self.setup_keybinds()

    def setup_keybinds(self):
        """Setup key bindings for standalone mode"""
        self.keybinds = {
            'close_tab': (Gdk.KEY_x, Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK),
            'close_tab_alt': (Gdk.KEY_q, Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK),
            'new_tab': (Gdk.KEY_z, Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK),
            'new_tab_alt': (Gdk.KEY_t, Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK),
        }

    def capture_terminal_snapshot(self, terminal):
        """Capture a snapshot of the terminal widget"""
        alloc = terminal.get_allocation()
        width = alloc.width
        height = alloc.height

        if width <= 0 or height <= 0:
            return None

        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, width, height)
        context = cairo.Context(surface)
        terminal.draw(context)
        pixbuf = Gdk.pixbuf_get_from_surface(surface, 0, 0, width, height)

        return pixbuf

    def update_snapshot_cache(self, force=False):
        """Update snapshot cache for all tabs

        Args:
            force: If True, bypass the time throttle
        """
        import time
        current_time = time.time()

        # Only update cache if more than 0.5 seconds have passed (unless forced)
        if not force and current_time - self.cache_timestamp < 0.5:
            return False

        self.cache_timestamp = current_time
        current_page = self.notebook.get_current_page()

        # Capture current tab (always visible) - key by terminal widget
        if current_page >= 0:
            tab = self.notebook.get_nth_page(current_page)
            pixbuf = self.capture_terminal_snapshot(tab)
            if pixbuf:
                self.snapshot_cache[tab] = pixbuf

        return False  # For GLib.timeout_add

    def get_cached_or_capture(self, terminal):
        """Get cached snapshot or capture new one

        Args:
            terminal: The VTE terminal widget to capture

        Returns:
            GdkPixbuf or None
        """
        # Try to get from cache first (keyed by terminal widget)
        if terminal in self.snapshot_cache:
            return self.snapshot_cache[terminal]

        # Try to capture (will only work if visible)
        pixbuf = self.capture_terminal_snapshot(terminal)
        if pixbuf:
            self.snapshot_cache[terminal] = pixbuf
        return pixbuf

    def invalidate_cache(self, terminal=None):
        """Invalidate snapshot cache

        Args:
            terminal: Specific terminal to invalidate, or None for all
        """
        if terminal is None:
            self.snapshot_cache.clear()
        elif terminal in self.snapshot_cache:
            del self.snapshot_cache[terminal]

    def periodic_update_callback(self):
        """Periodic callback to update active tab preview in switcher mode

        Returns:
            True to continue the timer, False to stop
        """
        if not self.active or self.mode != 'switcher':
            self.update_timer_id = None
            return False

        # Capture and update the current tab
        current_page = self.notebook.get_current_page()
        if current_page >= 0:
            tab = self.notebook.get_nth_page(current_page)
            pixbuf = self.capture_terminal_snapshot(tab)
            if pixbuf:
                self.snapshot_cache[tab] = pixbuf
                self.update_tile_image(current_page)

        return True  # Continue the timer

    def show(self, mode='standalone'):
        """Show tab overview

        Args:
            mode: 'standalone' for full control, 'switcher' for Alt-held mode
        """
        # If already active, check if we're switching modes
        if self.active:
            if self.mode == mode:
                # Same mode, toggle off
                self.hide()
                return
            else:
                # Different mode, switch to new mode
                self.hide()

        n_pages = self.notebook.get_n_pages()
        if n_pages == 0:
            return

        # Capture fresh snapshot of active tab before showing
        current_page = self.notebook.get_current_page()
        if current_page >= 0:
            tab = self.notebook.get_nth_page(current_page)
            pixbuf = self.capture_terminal_snapshot(tab)
            if pixbuf:
                self.snapshot_cache[tab] = pixbuf

        self.active = True
        self.mode = mode
        self.selected = current_page

        # Create main container
        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        # Add mode indicator at the top
        mode_label = Gtk.Label()
        mode_label.set_use_markup(True)

        # Get font from config
        fontdesc = Pango.FontDescription(self.config["tablist_font"])
        font_size_in_pt = fontdesc.get_size() / Pango.SCALE
        font_family = fontdesc.get_family()

        if mode == 'standalone':
            mode_text = f'<span font_family="{font_family}" size="{int(font_size_in_pt * 2)}pt" foreground="#4a9a9a"><b>TAB OVERVIEW MODE</b></span>\n<span font_family="{font_family}" size="{int(font_size_in_pt * 1.2)}pt" foreground="#888">ESC: exit | Enter: select | Arrows: navigate | Shift+Arrows: move tab | Ctrl+Alt+X: close | Ctrl+Alt+Z: new tab</span>'
        else:
            mode_text = f'<span font_family="{font_family}" size="{int(font_size_in_pt * 1.5)}pt" foreground="#888"><b>Tab Switcher</b></span>'
        mode_label.set_markup(mode_text)
        mode_label.set_margin_bottom(10)
        main_vbox.pack_start(mode_label, False, False, 0)

        # Create overview container
        self.overview_box = Gtk.Grid()
        self.overview_box.set_row_spacing(10)
        self.overview_box.set_column_spacing(10)
        self.overview_box.set_margin_start(20)
        self.overview_box.set_margin_end(20)
        self.overview_box.set_margin_top(0)
        self.overview_box.set_margin_bottom(20)
        self.overview_box.set_halign(Gtk.Align.CENTER)
        self.overview_box.set_valign(Gtk.Align.CENTER)

        main_vbox.pack_start(self.overview_box, True, True, 0)

        # Create event box for background
        bg_box = Gtk.EventBox()
        bg_box.set_name("overview-background")
        bg_box.add(main_vbox)

        # Calculate grid dimensions
        import math
        cols = math.ceil(math.sqrt(n_pages * 1.5))
        rows = math.ceil(n_pages / cols)

        # Calculate thumbnail size
        window_width = self.window.get_allocated_width()
        window_height = self.window.get_allocated_height()
        available_width = window_width - 100
        available_height = window_height - 100
        thumb_width = min(400, (available_width // cols) - 20)
        thumb_height = min(300, (available_height // rows) - 60)

        self.overview_tiles = []

        # Create tiles for each tab
        for idx in range(n_pages):
            tab = self.notebook.get_nth_page(idx)
            row = idx // cols
            col = idx % cols

            tile_box = Gtk.EventBox()
            tile_box.set_name("overview-tile")
            tile_box.set_events(Gdk.EventMask.BUTTON_PRESS_MASK)

            # Only connect click handler in standalone mode
            if mode == 'standalone':
                tile_box.connect("button-press-event", self.on_tile_clicked, idx)

            tile_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            tile_vbox.set_margin_start(10)
            tile_vbox.set_margin_end(10)
            tile_vbox.set_margin_top(10)
            tile_vbox.set_margin_bottom(10)

            # Get tab title
            if tab in self.tabs:
                params = self.tabs[tab]
                title = params.get("name", params.get("title", ""))
            else:
                title = ""

            if not title:
                title = f"Tab {idx + 1}"

            if len(title) > 30:
                title = title[:27] + "..."

            # Create header with label
            header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
            header_box.set_halign(Gtk.Align.CENTER)

            # Color indicator
            if tab in self.tabs and "group" in self.tabs[tab]:
                grp = self.tabs[tab]["group"]
                color_indicator = Gtk.Label()
                color_indicator.set_markup(f'<span foreground="{self.config["col_" + str(grp)]}">\u25cf</span>')
                header_box.pack_start(color_indicator, False, False, 0)

            # Create label
            label_text = f"<b>{idx + 1}</b>: {html.escape(title)}"
            label = Gtk.Label()
            label.set_use_markup(True)
            label.set_markup(label_text)
            label.set_line_wrap(True)
            label.set_max_width_chars(30)
            label.set_justify(Gtk.Justification.CENTER)

            header_box.pack_start(label, True, True, 0)
            tile_vbox.pack_start(header_box, False, False, 0)

            # Terminal snapshot with overlay for close button
            preview_overlay = Gtk.Overlay()

            # Terminal snapshot (use cache if available, keyed by terminal widget)
            pixbuf = self.get_cached_or_capture(tab)
            if pixbuf:
                scaled_pixbuf = pixbuf.scale_simple(
                    thumb_width, thumb_height,
                    GdkPixbuf.InterpType.BILINEAR
                )
                image = Gtk.Image.new_from_pixbuf(scaled_pixbuf)
                image.set_name(f"terminal-preview-{idx}")
                preview_overlay.add(image)
            else:
                placeholder = Gtk.Label()
                placeholder.set_markup("<i>Preview unavailable</i>")
                placeholder.set_size_request(thumb_width, thumb_height)
                preview_overlay.add(placeholder)

            # Add close button overlaid on top right corner
            close_button = Gtk.Button()
            close_button.set_label("\u00d7")  # × symbol
            close_button.set_name("overview-close-button")
            close_button.set_relief(Gtk.ReliefStyle.NONE)
            close_button.set_halign(Gtk.Align.END)
            close_button.set_valign(Gtk.Align.START)
            close_button.set_margin_top(5)
            close_button.set_margin_end(5)
            close_button.connect("clicked", self.on_close_button_clicked, idx)
            preview_overlay.add_overlay(close_button)

            tile_vbox.pack_start(preview_overlay, True, True, 0)

            # Entangled indicator
            if tab in self.entangled:
                entangled_label = Gtk.Label()
                entangled_label.set_markup(f'<span foreground="{self.config["tab_color_entangle"]}">*entangled*</span>')
                tile_vbox.pack_start(entangled_label, False, False, 0)

            tile_box.add(tile_vbox)
            self.overview_box.attach(tile_box, col, row, 1, 1)
            self.overview_tiles.append(tile_box)

        # Apply CSS for background and tile styling
        opacity = self.config.get('tab_overview_opacity', 0.85)

        css = f"""
        #overview-background {{
