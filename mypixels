        """Handle close button click"""
        n_pages = window.notebook.get_n_pages()
        if tab_index >= 0 and tab_index < n_pages:
            window.notebook.remove_page(tab_index)
            # Refresh the overview
            self.hide()
            # Check if any window still has tabs
            all_windows = self.app.windows if self.app else [self.mypixels]
            total_tabs = sum(w.notebook.get_n_pages() for w in all_windows)
            if total_tabs > 0:
                self.show()

    def update_selection(self, new_index=None):
        """Update visual indication of selected tile"""
        if not self.active or not self.overview_tiles:
            return

        if new_index is not None:
            self.selected = new_index

        # Tiles are tuples: (window, tab_index, tile_box)
        for window, tab_idx, tile_box in self.overview_tiles:
            # Highlight tile if it matches current window and selected tab
            if window == self.selected_window and tab_idx == self.selected:
                tile_box.set_name("overview-tile-selected")
            else:
                tile_box.set_name("overview-tile")

    def handle_key(self, event):
        """Handle keyboard navigation for full overview"""
        if not self.active:
            return False

        keyval = event.keyval
        mods = event.state & Gtk.accelerator_get_default_mod_mask()

        # ESC: exit
        if self._check_keybind(keyval, mods, 'overview_exit'):
            self.hide()
            return True

        # Alt+Return: Create new tab in current window - check this BEFORE overview_select
        if self._check_keybind(keyval, mods, 'overview_new_tab'):
            self.mypixels.new_tab()
            # Refresh overview to show new tab
            self.hide()
            self.show()
            return True

        # Enter: select current tile
        if self._check_keybind(keyval, mods, 'overview_select'):
            # Plain Return: Select current tile
            if self.overview_tiles:
                window, tab_idx, _ = self.overview_tiles[self._get_linear_selected_index()]
                window.window.present()
                window.notebook.set_current_page(tab_idx)
            self.hide()
            return True

        # Arrow key navigation across all tiles
        if self._check_keybind(keyval, mods, 'overview_nav_left'):
            self._navigate(-1)
            return True
        elif self._check_keybind(keyval, mods, 'overview_nav_right'):
            self._navigate(1)
            return True
        elif self._check_keybind(keyval, mods, 'overview_nav_up'):
            self._navigate(-4)  # Move up one row (4 cols per row)
            return True
        elif self._check_keybind(keyval, mods, 'overview_nav_down'):
            self._navigate(4)  # Move down one row
            return True

        # Ctrl+N: new window
        if self._check_keybind(keyval, mods, 'overview_new_window'):
            self.mypixels.app.new_window()
            self.hide()
            self.show()
            return True

        # Ctrl+M: move current tab to another window
        if self._check_keybind(keyval, mods, 'overview_move_tab'):
            self.hide()
            self.mypixels.send_tab_to_window()
            return True

        # Close tab
        if self._check_keybind(keyval, mods, 'close_tab'):
            if self.overview_tiles:
                window, tab_idx, _ = self.overview_tiles[self._get_linear_selected_index()]
                window.notebook.remove_page(tab_idx)
                self.hide()
                all_windows = self.app.windows if self.app else [self.mypixels]
                total_tabs = sum(w.notebook.get_n_pages() for w in all_windows)
                if total_tabs > 0:
                    self.show()
            return True

        # New tab
        if self._check_keybind(keyval, mods, 'new_tab'):
            self.mypixels.new_tab()
            self.hide()
            self.show()
            return True

        return False

    def _get_linear_selected_index(self):
        """Get the linear index of the currently selected tile"""
        for i, (window, tab_idx, _) in enumerate(self.overview_tiles):
            if window == self.selected_window and tab_idx == self.selected:
                return i
        return 0

    def _navigate(self, delta):
        """Navigate by delta tiles (positive or negative)"""
        if not self.overview_tiles:
            return

        current_idx = self._get_linear_selected_index()
        new_idx = current_idx + delta

        # Clamp to valid range
        new_idx = max(0, min(new_idx, len(self.overview_tiles) - 1))

        # Update selection
        window, tab_idx, _ = self.overview_tiles[new_idx]
        self.selected_window = window
        self.selected = tab_idx
        self.update_selection()


def dialog_get_text(parent, message, default=''):
    """
    Display a dialog with a text entry.
    Returns the text, or None if canceled.
    """
    d = Gtk.MessageDialog(transient_for=parent,
                          modal=True,
                          destroy_with_parent=True,
                          message_type=Gtk.MessageType.QUESTION,
                          buttons=Gtk.ButtonsType.OK_CANCEL,
                          text=message)
    entry = Gtk.Entry()
    entry.set_text(default)
    entry.show()
    d.vbox.pack_end(entry, False, False, 0)
    entry.connect('activate', lambda _: d.response(Gtk.ResponseType.OK))
    d.set_default_response(Gtk.ResponseType.OK)

    r = d.run()
    text = entry.get_text()
    d.destroy()
    if r == Gtk.ResponseType.OK:
        return text
    else:
        return None


class TabList:
    """Manages the tab list/bar display"""

    def __init__(self, notebook, tabs_dict, entangled_list, config_dict, on_tab_switch_state):
        """Initialize TabList

        Args:
            notebook: The Gtk.Notebook containing tabs
            tabs_dict: Dictionary mapping terminal widgets to tab metadata
            entangled_list: List of entangled terminals
            config_dict: Configuration dictionary
            on_tab_switch_state: Function returning current tab switch state
        """
        self.notebook = notebook
        self.tabs = tabs_dict
        self.entangled = entangled_list
        self.config = config_dict
        self.get_on_tabswitch = on_tab_switch_state

        # Create the container for tabs
        self.container = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.container.set_halign(Gtk.Align.START)
        self.container.set_valign(Gtk.Align.START)

        # Event box wrapper
        self.ebox = Gtk.EventBox()
        self.ebox.set_name("tabbar")
        self.ebox.add(self.container)
        self.ebox.show()  # Show the tab bar widget
        self.container.show()

        # Callbacks
        self.on_tab_clicked_cb = None
        self.on_add_tab_cb = None

    def get_widget(self):
        """Get the EventBox widget containing the tab list"""
        return self.ebox

    def set_callbacks(self, on_tab_clicked, on_add_tab):
        """Set callbacks for user interactions

        Args:
            on_tab_clicked: Callback(tab_index) when tab is clicked
            on_add_tab: Callback() when add button is clicked
        """
        self.on_tab_clicked_cb = on_tab_clicked
        self.on_add_tab_cb = on_add_tab

    def update(self, force_hide=False):
        """Update the tab list display

        Args:
            force_hide: If True, hide the tab list
        """
        # Clear existing tabs
        for child in self.container.get_children():
            self.container.remove(child)

        n_pages = self.notebook.get_n_pages()

        if (n_pages <= 1 and self.config["hide_single_tab"]) or force_hide:
            self.ebox.hide()
            return

        self.ebox.show()

        # Prepend callable if configured
        if self.config.get('tab_prepend'):
            prepend_label = Gtk.Label()
            prepend_label.set_use_markup(True)
            prepend_label.set_markup(callables[self.config['tab_prepend']]())
            self.container.pack_start(prepend_label, False, False, 0)
            prepend_label.show()

        # Add the [+] button
        add_tab_event_box = Gtk.EventBox()
        add_tab_event_box.set_name("add-tab-button")
        add_tab_event_box.set_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        add_tab_event_box.connect("button-press-event", self._on_add_tab_clicked)
        add_tab_event_box.set_tooltip_text("Create a new tab")

        add_tab_label = Gtk.Label()
        add_tab_label.set_markup("[+]")
        add_tab_label.set_margin_top(2)
        add_tab_label.set_margin_bottom(2)
        add_tab_label.get_style_context().add_class("tab-label")

        add_tab_event_box.add(add_tab_label)
        add_tab_event_box.show_all()
        self.container.pack_start(add_tab_event_box, False, False, 0)

        curidx = self.notebook.get_current_page()
        on_tabswitch = self.get_on_tabswitch()

        tab_format = self.config['tab_format']
        max_title_len = self.config['tab_title_max_length']
        tabl_short = self.config['tab_shorten_str']

        for idx, tab in enumerate(self.notebook):
            colfg = self.config["tab_color_fg"]
            colbg = self.config["tab_color_bg"]

            tid = idx + 1
            tidx = f"<span foreground=\"{self.config['tab_color_idx']}\">{tid}</span>"
            tname = ""

            tcorner = "["
            if on_tabswitch:
                tcorner = tidx

            if tab in self.tabs:
                params = self.tabs[tab]
                tid = params["id"]
                tname = params["title"]
                if "name" in params:
                    tname = params["name"]

            if not tname:
                tname = str(tid)

            # Shorten title for non-current tabs
            if idx != curidx:
                if max_title_len > 0 and len(tname) > max_title_len:
                    if self.config['tab_title_shorten_start']:
                        tname = tabl_short + tname[len(tname)-max_title_len:]
                    else:
                        tname = tname[:max_title_len] + tabl_short
            else:
                colfg = self.config["tab_color_fg_selected"]
                colbg = self.config["tab_color_bg_selected"]

                mt_cur = max_title_len
                sh_cur = self.config['tab_title_short_current']

                if isinstance(sh_cur, int):
                    mt_cur = sh_cur
                    sh_cur = True

                if sh_cur and mt_cur > 0 and len(tname) > mt_cur:
                   if self.config['tab_title_shorten_start']:
                       tname = tabl_short + tname[len(tname) - mt_cur:]
                   else:
                       tname = tname[:mt_cur] + tabl_short

            # Apply group color override if set
            if tab in self.tabs:
                grp = self.tabs[tab].get("group", None)
            else:
                grp = None

            if tab in self.entangled:
                entangled = f"<span foreground=\"{self.config['tab_color_entangle']}\">*</span>"
            else:
                entangled = ""

            if grp:
                colfg = self.config[f"col_{grp}"]

            color = f"foreground=\"{colfg}\" background=\"{colbg}\""

            # Escape HTML in title
            tname = html.escape(tname)

            # Create tab event box
            tab_event_box = Gtk.EventBox()
            tab_event_box.set_name(f"tab-{idx}")
            tab_event_box.set_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            tab_event_box.connect("button-press-event", self._on_tab_clicked, idx)

            tab_label = Gtk.Label()
            tab_label.set_use_markup(True)
            tab_label.set_justify(Gtk.Justification.LEFT)
            tab_label.set_line_wrap(False)
            tab_label.set_selectable(False)
            tab_label.set_margin_top(2)
            tab_label.set_margin_bottom(2)
            tab_label.set_halign(Gtk.Align.START)
            tab_label.set_valign(Gtk.Align.START)
            tab_label.set_ellipsize(Pango.EllipsizeMode.END)
            tab_label.get_style_context().add_class("tab-label")

            pango_markup = tab_format % locals()
            tab_label.set_markup(pango_markup)

            tab_event_box.add(tab_label)
            tab_event_box.show_all()
            self.container.pack_start(tab_event_box, False, False, 0)

    def _on_tab_clicked(self, widget, event, tab_index):
        """Internal handler for tab clicks"""
        if event.button == 1 and self.on_tab_clicked_cb:
            self.on_tab_clicked_cb(tab_index)

    def _on_add_tab_clicked(self, widget, event):
        """Internal handler for add button clicks"""
        if event.button == 1 and self.on_add_tab_cb:
            self.on_add_tab_cb()

class MypixelsWindow:
    def __init__(self, app):
