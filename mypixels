    def quit_request(self, *args):
        # if there is more than one tab, ask
        if (self.notebook.get_n_pages() > 1):
            # ask first
            dialog = Gtk.MessageDialog(transient_for=self.window,
                                       modal=True, destroy_with_parent=True,
                                       message_type=Gtk.MessageType.INFO,
                                       buttons=Gtk.ButtonsType.YES_NO,
                                       text="Do you really want to close?")

            rv = dialog.run()
            dialog.destroy()

            if rv != Gtk.ResponseType.YES:
                return True # cancel the quit

        # Cleanup and quit
        # Remove this window from the application
        self.app.remove_window(self)

        # If this was the last window, quit the application
        if len(self.app.windows) == 0:
            self.app.quit()
        else:
            # Just close this window
            self.window.destroy()

        return True  # Prevent default close handler

    def load_config(self):
        config_path = Path.home() / ".mypixels"

        try:
            if not config_path.exists():
                print(f"No config file found at {config_path}, using defaults")
                self.load_wal_palette()
                return

            with open(config_path) as f:
                myconfig = yaml.load(f, Loader=yaml.FullLoader)

            try:
                for k in self.config.keys():
                    # if this is a keymap, descend
                    if k == "bindings":
                        if "bindings" in myconfig:
                            for fn, b in myconfig['bindings'].items():
                                self.config[k][fn] = b
                    else:
                        if k in myconfig:
                            self.config[k] = myconfig[k]
            except Exception as e:
                print(f"Config parse error: {e}")

            # Validate configuration
            validation_warnings = validate_config(self.config)
            if validation_warnings:
                print("Configuration validation warnings:")
                for warning in validation_warnings:
                    print(f"  - {warning}")

        except Exception as e:
            print(f"Error loading config from {config_path}: {e}")
            traceback.print_exc()

        # try to override the colors from wal palette if that is set to be used
        self.load_wal_palette()

    def apply_tab_colors(self, tab):
        bg_color = Gdk.RGBA()
        bg_color.parse(self.config['bg_tint_color'])
        bg_color.alpha=1.0-self.config['term_opacity']

        if self.palette:
            # Apply the same alpha to the palette background color
            transparent_bg = self.bg_color.copy()
            transparent_bg.alpha = 1.0-self.config['term_opacity']
            tab.set_colors(self.fg_color, transparent_bg, self.palette)
        else:
            # No palette, just set foreground and background with transparency
            tab.set_colors(self.fg_color, bg_color, [])

    def apply_config(self):
        # higlights tab nums on press
        self.on_tabswitch_key = key_press_parse(self.config["tab_highlight_mod"])[1]

        # parse the config key bindings
        self.set_funcmap()
        self.keymap = self.config['bindings']
        self.transform_keybinds()

        # convert the call config vars to callables
        if 'palette' in self.config:
            colors = self.config['palette'].split(':')
            self.palette = []
            for color in colors:
                if color:
                    self.palette.append(parse_rgba(color))
        else:
            self.palette = None

        self.fg_color = parse_rgba(self.config['foreground_color'])
        self.bg_color = parse_rgba(self.config['background_color'])

        

        fontdesc = Pango.FontDescription(self.config["tablist_font"])
        font_size_in_pt = fontdesc.get_size() / Pango.SCALE

        bgcolor = self.config['tablist_background']
        # TODO: self.tab_list.get_widget().modify_bg(Gtk.STATE_NORMAL, bgcolor)

        css = f"""
        #tabbar {{
            background-color: {bgcolor};
        }}
        #tabbar GtkEventBox {{ /* Style for individual tab containers */
            padding: 2px 8px; /* Add some padding for visual separation */
            margin-right: 1px; /* Space between tabs */
        }}
        #tabbar .tab-label {{ /* Style for the text within tabs */
            font-family: "{fontdesc.get_family()}";
            font-size: {font_size_in_pt}pt;
        }}
        #tabbar #add-tab-button {{ /* Style for the add tab button */
            background-color: {brighten(bgcolor, 1.1)}; /* Slightly brighter background for the button */
            padding: 2px 8px;
            margin-right: 1px;
        }}
        #tabbar #add-tab-button .tab-label {{ /* Style for the text within the add tab button */
            color: {self.config['add_button_color']};
        }}
        """

        style_provider = Gtk.CssProvider()
        style_provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        if self.config["tablist_top"]:
            self.vbox.reorder_child(self.tab_list.get_widget(), 0)
            self.vbox.reorder_child(self.notebook, 1)
        else:
            self.vbox.reorder_child(self.notebook, 1)
            self.vbox.reorder_child(self.tab_list.get_widget(), 2)

        # window fixup before we create tab
        if self.config["default_maximize"]:
            self.window.maximize()
        else:
            self.window.resize(self.config["default_width"], self.config["default_height"])


        # iterate all tabs in our list and re-apply the background
        for idx, tab in enumerate(self.notebook):
            self.apply_tab_colors(tab)

        # repaint the tab bar
        self.update_tablist()

    def reload_config(self, arg=None):
        print("Reloading config...")
        # tries to reload config and re-apply what can be
        self.load_config()
        self.hook_wal_reloads()
        self.apply_config()

    def file_changed(monitor, file, other, unknown, event, self):
        if event == Gio.FileMonitorEvent.CHANGES_DONE_HINT:
           self.load_wal_palette()
           self.apply_config()

    def hook_wal_reloads(self):
        wal_path = Path(self.config['wal_palette']).expanduser()
        self.wal_file = Gio.File.new_for_path(str(wal_path))
        print(f"Will monitor {self.wal_file.get_uri()}")
        self.monitor = self.wal_file.monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", self.file_changed, self)

    def load_wal_palette(self):
        # if specified in config file, we try to load the yml version of wal palette
        if ('wal_palette' not in self.config) or self.config['wal_palette'] == '':
            print("No wal_palette specified in config. Skipping")
            return

        wal_path = Path(self.config['wal_palette']).expanduser()

        try:
            if not wal_path.exists():
                print(f"Wal palette file not found: {wal_path}")
                return

            with open(wal_path) as f:
                mypal = yaml.load(f, Loader=yaml.FullLoader)
                # special category contains foreground and background
                bgcol  = mypal['special']['background']
                fgcol  = mypal['special']['foreground']
                curcol = mypal['special']['cursor']

                src_cols = mypal['colors']
                colors = []
                for n in range(0, 16):
                      colors.append(src_cols['color' + str(n)])

                # that's all there's to it, really. Now we apply those
                tab_bg = brighten(bgcol, 1.5)

                self.config['background_color']   = bgcol
                self.config['bg_tint_color']      = bgcol
                self.config['foreground_color']   = fgcol

                self.config['tablist_background'] = tab_bg
                self.config['tab_color_bg'] = tab_bg
                self.config['tab_color_bg_selected'] = brighten(tab_bg, 1.5)
                self.config['tab_color_fg'] = fgcol
                self.config['tab_color_fg_selected'] = curcol

                self.config['tab_color_entangle'] = colors[1]
                self.config['tab_color_idx'] = colors[2]

                for n in range(0,8):
                      self.config['col_' + str(n)] = colors[n]

                # and at last, the palette
                self.config['palette'] = ':'.join(colors)

                print("Loaded wal colors")
        except Exception as e:
            exc_info = sys.exc_info()
            traceback.print_exception(*exc_info)
            print("Cannot load/apply wal colors: %s!" % repr(e))

class MypixelsApplication(Gtk.Application):
    """Application-level manager for mypixels

    Manages multiple windows, shared configuration, and D-Bus single-instance detection.
    """

    def __init__(self):
        super().__init__(
            application_id="com.github.volca.mypixels",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )
        self.windows = []  # List of MypixelsWindow instances
        self.command_args = None
        self.config = config  # Shared config across all windows
        self.tab_counter = counter()  # Global tab ID generator

    def do_activate(self):
        """Called when application is activated (first launch or by remote instance)"""
        # Always create a new window
        self.new_window(self.command_args)

    def new_window(self, command=None):
        """Create a new window

        Args:
            command: Optional command to run in new tabs
        """
        window = MypixelsWindow(self)
        self.windows.append(window)
        self.add_window(window.window)

        # Set command if provided
        if command:
            window.command = command

        # Create first tab
        window.new_tab()

        # Show window
        window.window.present()

    def remove_window(self, window):
        """Remove a window from the application

        Args:
            window: MypixelsWindow instance to remove
        """
        if window in self.windows:
            self.windows.remove(window)
            # Also remove from GTK application
            super().remove_window(window.window)

    def do_command_line(self, command_line):
        """Called when mypixels is run again while already running"""
        # Get command line arguments
        argv = command_line.get_arguments()

        # Store args for new window (skip program name)
        if len(argv) > 1:
            self.command_args = argv[1:]
        else:
            self.command_args = None

        # Activate (will create window or bring to front)
        self.activate()

        return 0  # Return 0 for success

def main():
    """Main entry point for mypixels"""
    app = MypixelsApplication()
    exit_status = app.run(sys.argv)
    sys.exit(exit_status)

if __name__ == '__main__':
    main()
