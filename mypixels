            GLib.source_remove(self.update_timer_id)
            self.update_timer_id = None

        if self.overview_bg_box:
            self.overlay.remove(self.overview_bg_box)
            self.overview_bg_box = None
        self.overview_tiles = []

        # Refocus current tab
        current_page = self.notebook.get_current_page()
        if current_page >= 0:
            tab = self.notebook.get_nth_page(current_page)
            tab.grab_focus()

    def update_selection(self, new_index=None):
        """Update visual indication of selected tile"""
        if not self.active or not self.overview_tiles:
            return

        if new_index is not None:
            self.selected = new_index

        for idx, tile in enumerate(self.overview_tiles):
            if idx == self.selected:
                tile.set_name("overview-tile-selected")
            else:
                tile.set_name("overview-tile")

    def update_tile_image(self, tab_index):
        """Update the image of a specific tile

        Args:
            tab_index: Index of the tab to update
        """
        if not self.active or not self.overview_tiles:
            return

        if tab_index < 0 or tab_index >= len(self.overview_tiles):
            return

        # Get the terminal widget
        tab = self.notebook.get_nth_page(tab_index)
        if tab not in self.snapshot_cache:
            return

        # Find the image widget in the tile and update it
        tile_box = self.overview_tiles[tab_index]
        tile_vbox = tile_box.get_child()
        if not tile_vbox:
            return

        # Find the Gtk.Overlay that contains the image
        preview_overlay = None
        for child in tile_vbox.get_children():
            if isinstance(child, Gtk.Overlay):
                preview_overlay = child
                break

        if not preview_overlay:
            return

        # Get the first child of the overlay (the image or placeholder)
        image = preview_overlay.get_child()
        if not isinstance(image, Gtk.Image):
            return

        # Update the image using stored thumbnail dimensions
        pixbuf = self.snapshot_cache[tab]

        # Use the thumbnail dimensions that were calculated when overview was shown
        thumb_width = getattr(self, 'thumb_width', 300)
        thumb_height = getattr(self, 'thumb_height', 225)

        scaled_pixbuf = pixbuf.scale_simple(
            thumb_width, thumb_height,
            GdkPixbuf.InterpType.BILINEAR
        )
        image.set_from_pixbuf(scaled_pixbuf)

    def on_key_press(self, widget, event):
        """Capture key press events when overview is active

        Returns True to stop propagation to terminals
        """
        if not self.active:
            return False

        # Handle the key if in standalone mode
        if self.mode == 'standalone':
            self.handle_key(event)

        # Always stop propagation when overview is active
        return True

    def on_key_release(self, widget, event):
        """Capture key release events when overview is active

        Returns True to stop propagation to terminals
        """
        if not self.active:
            return False

        # Always stop propagation when overview is active
        return True

    def handle_key(self, event):
        """Handle keyboard navigation

        Returns True if handled, False otherwise
        """
        if not self.active:
            return False

        keyval = event.keyval
        mods = event.state & Gtk.accelerator_get_default_mod_mask()
        n_pages = self.notebook.get_n_pages()

        import math
        cols = math.ceil(math.sqrt(n_pages * 1.5))

        # Close tab
        if self._check_keybind(keyval, mods, 'close_tab'):
            if self.selected >= 0 and self.selected < n_pages:
                current_mode = self.mode
                self.notebook.remove_page(self.selected)
                new_n_pages = self.notebook.get_n_pages()
                if new_n_pages == 0:
                    self.hide()
                else:
                    if self.selected >= new_n_pages:
                        self.selected = new_n_pages - 1
                    self.hide()
                    self.show(mode=current_mode)
            return True

        # New tab (from config bindings)
        if self._check_keybind(keyval, mods, 'new_tab'):
            current_mode = self.mode
            self.mypixels.new_tab()
            self.hide()
            self.show(mode=current_mode)
            return True

        # Exit overview
        if self._check_keybind(keyval, mods, 'overview_exit'):
            self.hide()
            return True

        # New tab (Alt+Return) - check this BEFORE overview_select
        if self._check_keybind(keyval, mods, 'overview_new_tab'):
            current_mode = self.mode
            self.mypixels.new_tab()
            self.hide()
            self.show(mode=current_mode)
            return True

        # Select tab (plain Return) - check this AFTER overview_new_tab
        if self._check_keybind(keyval, mods, 'overview_select'):
            self.notebook.set_current_page(self.selected)
            self.hide()
            return True

        # Move tab left
        if self._check_keybind(keyval, mods, 'overview_move_left'):
            if self.selected > 0:
                tab = self.notebook.get_nth_page(self.selected)
                self.notebook.reorder_child(tab, self.selected - 1)
                self.selected -= 1
                self.hide()
                self.show(mode='standalone')
            return True

        # Navigate left
        if self._check_keybind(keyval, mods, 'overview_nav_left'):
            if self.selected > 0:
                self.update_selection(self.selected - 1)
            return True

        # Move tab right
        if self._check_keybind(keyval, mods, 'overview_move_right'):
            if self.selected < n_pages - 1:
                tab = self.notebook.get_nth_page(self.selected)
                self.notebook.reorder_child(tab, self.selected + 1)
                self.selected += 1
                self.hide()
                self.show(mode='standalone')
            return True

        # Navigate right
        if self._check_keybind(keyval, mods, 'overview_nav_right'):
            if self.selected < n_pages - 1:
                self.update_selection(self.selected + 1)
            return True

        # Move tab up
        if self._check_keybind(keyval, mods, 'overview_move_up'):
            if self.selected >= cols:
                tab = self.notebook.get_nth_page(self.selected)
                new_pos = self.selected - cols
                self.notebook.reorder_child(tab, new_pos)
                self.selected = new_pos
                self.hide()
                self.show(mode='standalone')
            return True

        # Navigate up
        if self._check_keybind(keyval, mods, 'overview_nav_up'):
            if self.selected >= cols:
                self.update_selection(self.selected - cols)
            return True

        # Move tab down
        if self._check_keybind(keyval, mods, 'overview_move_down'):
            if self.selected + cols < n_pages:
                tab = self.notebook.get_nth_page(self.selected)
                new_pos = self.selected + cols
                self.notebook.reorder_child(tab, new_pos)
                self.selected = new_pos
                self.hide()
                self.show(mode='standalone')
            return True

        # Navigate down
        if self._check_keybind(keyval, mods, 'overview_nav_down'):
            if self.selected + cols < n_pages:
                self.update_selection(self.selected + cols)
            return True

        # First tab
        if self._check_keybind(keyval, mods, 'overview_first'):
            self.update_selection(0)
            return True

        # Last tab
        if self._check_keybind(keyval, mods, 'overview_last'):
            self.update_selection(n_pages - 1)
            return True
        elif keyval >= Gdk.KEY_1 and keyval <= Gdk.KEY_9:
            idx = keyval - Gdk.KEY_1
            if idx < n_pages:
                self.notebook.set_current_page(idx)
                self.hide()
            return True
        elif keyval == Gdk.KEY_0:
            if n_pages > 9:
                self.notebook.set_current_page(9)
                self.hide()
            return True

        return False

    def on_tile_clicked(self, widget, event, tab_index):
        """Handle mouse click on tile (standalone mode only)"""
        if event.button == 1 and self.mode == 'standalone':
            self.notebook.set_current_page(tab_index)
            self.hide()

    def on_close_button_clicked(self, button, tab_index):
        """Handle close button click in standalone mode"""
        n_pages = self.notebook.get_n_pages()
        if tab_index >= 0 and tab_index < n_pages:
            self.notebook.remove_page(tab_index)
            # Refresh the overview or hide if no tabs left
            new_n_pages = self.notebook.get_n_pages()
            if new_n_pages == 0:
                self.hide()
            else:
                # Adjust selection if needed
                if self.selected >= new_n_pages:
                    self.selected = new_n_pages - 1
                # Refresh overview
                self.hide()
                self.show(mode='standalone')


